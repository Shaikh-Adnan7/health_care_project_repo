{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "health-care-project-DF"
		},
		"LS_ADB_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'LS_ADB'"
		},
		"LS_ADB_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1123-162420-y5tiyra3"
		},
		"LS_ADLS_Gen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://healthcaresa2026.dfs.core.windows.net/"
		},
		"LS_Azure_KeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://health-care-key-vault.vault.azure.net/"
		},
		"LS_Azure_SQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "health-care-project-server2026.database.windows.net"
		},
		"LS_Azure_SQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "health_care_db"
		},
		"LS_Azure_SQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "avd"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_SQL_TO_RAW_INCREMENTAL')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Metadata-driven full and incremental ingestion from Azure SQL to ADLS Gen2",
				"activities": [
					{
						"name": "LKP_Get_Table_Metadata",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT\n    table_id,\n    schema_name,\n    table_name,\n    watermark_column,\n    CONVERT(VARCHAR(23), last_watermark, 121) AS last_watermark\nFROM dbo.ingestion_control\nWHERE is_active = 1\nORDER BY table_id;",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_Dynamic",
								"type": "DatasetReference",
								"parameters": {
									"schema_name": "dbo",
									"table_name": "ingestion_control"
								}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "FE_Iterate_Tables",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "LKP_Get_Table_Metadata",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('LKP_Get_Table_Metadata').output.value",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "LKP_Get_New_Watermark",
									"type": "Lookup",
									"state": "Active",
									"onInactiveMarkAs": "Succeeded",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat(\n    'SELECT CONVERT(VARCHAR(23), MAX([',\n    item().watermark_column,\n    ']), 121) AS new_watermark FROM [',\n    item().schema_name,\n    '].[',\n    item().table_name,\n    ']'\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "DS_SQL_Dynamic",
											"type": "DatasetReference",
											"parameters": {
												"schema_name": {
													"value": "@item().schema_name",
													"type": "Expression"
												},
												"table_name": {
													"value": "@item().table_name",
													"type": "Expression"
												}
											}
										}
									}
								},
								{
									"name": "If Condition1",
									"type": "IfCondition",
									"dependsOn": [
										{
											"activity": "LKP_Get_New_Watermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"expression": {
											"value": "@greater(\n    ticks(\n        coalesce(\n            activity('LKP_Get_New_Watermark').output.firstRow.new_watermark,\n            item().last_watermark\n        )\n    ),\n    ticks(item().last_watermark)\n)",
											"type": "Expression"
										},
										"ifTrueActivities": [
											{
												"name": "CP_SQL_TO_RAW",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "AzureSqlSource",
														"sqlReaderQuery": {
															"value": "@concat(\n    'SELECT * FROM [',\n    item().schema_name,\n    '].[',\n    item().table_name,\n    '] WHERE [',\n    item().watermark_column,\n    '] > ''',\n    item().last_watermark,\n    ''' AND [',\n    item().watermark_column,\n    '] <= ''',\n    activity('LKP_Get_New_Watermark').output.firstRow.new_watermark,\n    ''''\n)",
															"type": "Expression"
														},
														"queryTimeout": "02:00:00",
														"partitionOption": "None"
													},
													"sink": {
														"type": "ParquetSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "ParquetWriteSettings"
														}
													},
													"enableStaging": false,
													"translator": {
														"type": "TabularTranslator",
														"typeConversion": true,
														"typeConversionSettings": {
															"allowDataTruncation": true,
															"treatBooleanAsNumber": false
														}
													}
												},
												"inputs": [
													{
														"referenceName": "DS_SQL_Dynamic",
														"type": "DatasetReference",
														"parameters": {
															"schema_name": {
																"value": "@item().schema_name",
																"type": "Expression"
															},
															"table_name": {
																"value": "@item().table_name",
																"type": "Expression"
															}
														}
													}
												],
												"outputs": [
													{
														"referenceName": "DS_ADLS_Parquet_Dynamic",
														"type": "DatasetReference",
														"parameters": {
															"folder_path": {
																"value": "@concat(\n    item().table_name,\n    '/',\n    formatDateTime(pipeline().TriggerTime,'yyyy/MM/dd')\n)",
																"type": "Expression"
															},
															"file_name": {
																"value": "@concat(\n    item().table_name\n)",
																"type": "Expression"
															}
														}
													}
												]
											},
											{
												"name": "NOTIFY_ON_SUCCESS",
												"description": "",
												"type": "WebActivity",
												"dependsOn": [
													{
														"activity": "CP_SQL_TO_RAW",
														"dependencyConditions": [
															"Failed"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"method": "POST",
													"headers": {},
													"url": "https://prod-06.centralindia.logic.azure.com:443/workflows/6b0bed26e6664091b12fc3fc31b80506/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=AgKdqOMpVypbwwgpqSSc7qoAigweccHuKoXteygs_1I",
													"body": {
														"value": "{\n    \"pipelineName\" : @{pipeline().Pipeline},\n    \"DataFactoryName\" : @{pipeline().DataFactory},\n    \"RunId\": @{pipeline().RunId},\n}",
														"type": "Expression"
													}
												}
											},
											{
												"name": "SP_Insert_Log_Info",
												"type": "SqlServerStoredProcedure",
												"dependsOn": [
													{
														"activity": "SP_Update_Watermark",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"storedProcedureName": "[[dbo].[proc_for_log_info]",
													"storedProcedureParameters": {
														"copied_rows": {
															"value": {
																"value": "@int(activity('CP_SQL_TO_RAW').output.rowsCopied)",
																"type": "Expression"
															},
															"type": "Int64"
														},
														"pipeline_run_id": {
															"value": {
																"value": "@pipeline().RunId",
																"type": "Expression"
															},
															"type": "String"
														},
														"read_rows": {
															"value": {
																"value": "@int(activity('CP_SQL_TO_RAW').output.rowsCopied)",
																"type": "Expression"
															},
															"type": "Int64"
														},
														"table_name": {
															"value": {
																"value": "@item().table_name",
																"type": "Expression"
															},
															"type": "String"
														}
													}
												},
												"linkedServiceName": {
													"referenceName": "LS_Azure_SQL",
													"type": "LinkedServiceReference"
												}
											},
											{
												"name": "NB_RAW_TO_BRONZE",
												"type": "DatabricksNotebook",
												"dependsOn": [
													{
														"activity": "CP_SQL_TO_RAW",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"notebookPath": "/Users/adnan@sameerpatel5116outlook.onmicrosoft.com/Health_care_Project_NoteBooks/RAW_TO_BRONZE",
													"baseParameters": {
														"batch_info": {
															"value": "@concat(\n  '[{\"table_name\":\"',\n  item().table_name,\n  '\",\"source_path\":\"abfss://raw@healthcaresa2026.dfs.core.windows.net/',\n  item().table_name,\n  '/',\n  formatDateTime(utcNow(),'yyyy/MM/dd'),\n  '/',\n  item().table_name,\n  '/\"}]'\n)",
															"type": "Expression"
														},
														"target_container": "bronz",
														"catalog_name": "healthcare_catalog"
													}
												},
												"linkedServiceName": {
													"referenceName": "LS_ADB",
													"type": "LinkedServiceReference"
												}
											},
											{
												"name": "SP_Update_Watermark",
												"type": "SqlServerStoredProcedure",
												"dependsOn": [
													{
														"activity": "NB_RAW_TO_BRONZE",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"storedProcedureName": "[[dbo].[usp_update_watermark]",
													"storedProcedureParameters": {
														"new_watermark": {
															"value": {
																"value": "@activity('LKP_Get_New_Watermark').output.firstRow.new_watermark",
																"type": "Expression"
															},
															"type": "DateTime"
														},
														"table_id": {
															"value": {
																"value": "@item().table_id",
																"type": "Expression"
															},
															"type": "Int32"
														}
													}
												},
												"linkedServiceName": {
													"referenceName": "LS_Azure_SQL",
													"type": "LinkedServiceReference"
												}
											}
										]
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_SQL_Dynamic')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_Parquet_Dynamic')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_Azure_SQL')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_ADB')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_ADLS_Parquet_Dynamic')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_ADLS_Gen2",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"folder_path": {
						"type": "string"
					},
					"file_name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Parquet",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().file_name",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().folder_path",
							"type": "Expression"
						},
						"fileSystem": "raw"
					},
					"compressionCodec": "snappy"
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_ADLS_Gen2')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_SQL_Dynamic')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_Azure_SQL",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"schema_name": {
						"type": "string"
					},
					"table_name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {
					"schema": {
						"value": "@dataset().schema_name",
						"type": "Expression"
					},
					"table": {
						"value": "@dataset().table_name",
						"type": "Expression"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_Azure_SQL')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_ADB')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureDatabricks",
				"typeProperties": {
					"domain": "https://adb-7405611114613684.4.azuredatabricks.net",
					"accessToken": {
						"type": "SecureString",
						"value": "[parameters('LS_ADB_accessToken')]"
					},
					"existingClusterId": "[parameters('LS_ADB_properties_typeProperties_existingClusterId')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_ADLS_Gen2')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('LS_ADLS_Gen2_properties_typeProperties_url')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_Azure_KeyVault')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('LS_Azure_KeyVault_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_Azure_SQL')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('LS_Azure_SQL_properties_typeProperties_server')]",
					"database": "[parameters('LS_Azure_SQL_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('LS_Azure_SQL_properties_typeProperties_userName')]",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "LS_Azure_KeyVault",
							"type": "LinkedServiceReference"
						},
						"secretName": "azure-sql-credential"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_Azure_KeyVault')]"
			]
		}
	]
}