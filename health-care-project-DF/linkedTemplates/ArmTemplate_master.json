{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "health-care-project-DF"
		},
		"LS_ADB_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'LS_ADB'"
		},
		"LS_ADB_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1123-162420-y5tiyra3"
		},
		"LS_ADLS_Gen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://healthcaresa2026.dfs.core.windows.net/"
		},
		"LS_Azure_KeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://health-care-key-vault.vault.azure.net/"
		},
		"LS_Azure_SQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "health-care-project-server2026.database.windows.net"
		},
		"LS_Azure_SQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "health_care_db"
		},
		"LS_Azure_SQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "avd"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "health-care-project-DF_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADB_accessToken": {
						"value": "[parameters('LS_ADB_accessToken')]"
					},
					"LS_ADB_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_ADB_properties_typeProperties_existingClusterId')]"
					},
					"LS_ADLS_Gen2_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Gen2_properties_typeProperties_url')]"
					},
					"LS_Azure_KeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_Azure_KeyVault_properties_typeProperties_baseUrl')]"
					},
					"LS_Azure_SQL_properties_typeProperties_server": {
						"value": "[parameters('LS_Azure_SQL_properties_typeProperties_server')]"
					},
					"LS_Azure_SQL_properties_typeProperties_database": {
						"value": "[parameters('LS_Azure_SQL_properties_typeProperties_database')]"
					},
					"LS_Azure_SQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_Azure_SQL_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}